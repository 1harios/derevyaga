####################################################################
# Деревяга — переменные окружения
# Скопируйте файл в .env и заполните значения. В git .env не попадает.
# Всё, что помечено «итерация 3/4/5», понадобится на соответствующем этапе,
# без этих значений сайт запускается и работает.
####################################################################

# ── Базовое ────────────────────────────────────────────────────────
# Адрес сайта без слэша на конце. Используется в метаданных, sitemap и ссылках.
NEXT_PUBLIC_SITE_URL=https://derevyaga.ru

# Демонстрационный режим форм: 1 — заявка не уходит на сервер, показывается
# экран благодарности. Нужен только для показа вёрстки, на бою всегда 0.
NEXT_PUBLIC_DEMO_MODE=0

# ── База данных (итерация 3) ───────────────────────────────────────
# PostgreSQL на российском хостинге. Формат: postgresql://user:pass@host:5432/db
DATABASE_URL=

# ── CRM: amoCRM (работает уже сейчас) ──────────────────────────────
# Заявки с форм уходят сделками в amoCRM (см. src/lib/amocrm.ts).
# Пока значения пустые, заявки остаются в логе сервера — сайт работает.

# Поддомен аккаунта, без https:// и слэшей. Пример: derevyaga.amocrm.ru
AMO_DOMAIN=
# Долгосрочный токен: amoCRM → Настройки → Интеграции → ваша интеграция →
# вкладка «Ключи» → «Сгенерировать токен». Показывается один раз — скопируйте.
AMO_TOKEN=
# ID воронки для новых заявок. Пусто — первый этап главной воронки.
AMO_PIPELINE_ID=
# ID списка «Проекты домов» в amoCRM.
AMO_PROJECTS_CATALOG_ID=
# Секрет служебных команд синхронизации. Не добавлять в NEXT_PUBLIC_*.
AMO_ADMIN_SECRET=

# Онлайн-чат amoCRM («Кнопка на сайт») настраивается НЕ здесь: код кнопки
# вставляется в src/content/integrations.ts — см. комментарий в файле.

# ── Telegram (итерация 3) ──────────────────────────────────────────
# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=
# ID рабочего чата отдела продаж. Для групп значение отрицательное.
TELEGRAM_SALES_CHAT_ID=
# ID тем в чате, если темы включены. Пусто — все сообщения в общий поток.
TELEGRAM_TOPIC_HOT=
TELEGRAM_TOPIC_LEADS=
TELEGRAM_TOPIC_QUESTIONS=
TELEGRAM_TOPIC_VACANCIES=
# Чат администраторов для тревожных сообщений о сбоях доставки
TELEGRAM_ADMIN_CHAT_ID=
# Секрет для проверки вызовов вебхука Telegram
TELEGRAM_WEBHOOK_SECRET=

# ── Антиспам (итерация 3) ──────────────────────────────────────────
# Яндекс SmartCaptcha. Google reCAPTCHA не используем: нестабильна в России.
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# ── Почта отдела продаж (итерация 3) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SALES_EMAIL=

# ── Файлы и кабинет (итерация 4) ───────────────────────────────────
# S3-совместимое хранилище российского провайдера
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Время жизни подписанной ссылки на файл, секунды
S3_SIGNED_URL_TTL=900

# Вход в кабинет по СМС
SMS_PROVIDER=smsru
SMS_API_KEY=
SMS_SENDER=

# Секрет для подписи сессионных cookie. Сгенерируйте: openssl rand -base64 32
AUTH_SECRET=

# ── Аналитика (итерация 5) ─────────────────────────────────────────
# Номер счётчика Яндекс.Метрики. Счётчик не запускается без согласия на cookie.
NEXT_PUBLIC_YM_COUNTER_ID=
